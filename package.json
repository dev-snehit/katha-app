{
  "name": "katha-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "tsc --noEmit",
    "format:check": "node -e \"const fs=require('fs'),p=require('path'); ['package.json','tsconfig.json','src/config/roles/roles.json','src/config/roles/owner.json','src/config/roles/admin.json','src/config/roles/staff.json','src/config/roles/customer.json'].forEach(f=>JSON.parse(fs.readFileSync(p.resolve(f),'utf8'))); console.log('JSON & format check passed');\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/*.test.ts tests/unit",
    "test:ui": "vitest run tests/ui",
    "test:backend": "vitest run tests/backend",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test -- --run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.4.7",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^21.0.4",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
